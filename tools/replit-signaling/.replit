# Replit config for running matchbox_server.

entrypoint = "main.sh"
run = ["sh", "main.sh"]

[nix]
channel = "stable-24_05"

[deployment]
# Reserved VM (always-on) — Autoscale would break WebSockets
# (no session affinity = peers land on different instances
# and never see each other).
deploymentTarget = "vm"

# `build` runs ONCE when the deployment is created, with no
# port-open timeout. We `cargo install` matchbox_server here
# so the deployment's `run` step is just "launch the
# already-compiled binary" and the port opens immediately.
# Without this, Replit's deployment health-check kills the
# process partway through the ~5 min compile.
#
# `--root .` puts the binary in `./bin/matchbox_server` so
# Replit's deployment snapshot picks it up.
build = ["sh", "-c", "cargo install --locked --root . matchbox_server@0.14.0"]

# `run` launches the pre-built binary. Bind to whatever port
# Replit assigns via $PORT (falls back to 3536 for local dev).
run = ["sh", "-c", "exec ./bin/matchbox_server 0.0.0.0:${PORT:-3536}"]

# Local dev port hint — only used inside the workspace, not
# the deployment.
[[ports]]
localPort = 3536
externalPort = 80
