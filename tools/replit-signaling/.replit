# Replit config for running matchbox_server.
#
# `entrypoint` + `run` are what Replit invokes when you hit
# Run; we shell out to main.sh which handles the
# install-on-first-run + binary launch.

entrypoint = "main.sh"
run = ["sh", "main.sh"]

[nix]
channel = "stable-24_05"

[deployment]
# Use a Reserved VM (always-on) deployment, NOT Autoscale.
# Autoscale (cloudrun) scales to zero between requests, which
# kills persistent WebSocket connections — peers would have to
# pay a cold-start every reconnect. Reserved VM stays up.
#
# Pick "Reserved VM" in the Replit Deploy UI when promoting
# this Repl; the `deploymentTarget` line below is just a hint
# to the workspace.
run = ["sh", "main.sh"]
deploymentTarget = "vm"

# Bind to the default matchbox port. Replit's Webview tab will
# show the public URL once the process is listening.
[[ports]]
localPort = 3536
externalPort = 80
